# Copy this file to .env and fill in only what you need. Never share or commit .env.
# Everything here is optional: scan, shadow and paper work with no keys at all.

# Optional: Alpaca keys. Needed ONLY for broker.mode = "alpaca_paper" or "alpaca_live".
# Create PAPER keys first at https://alpaca.markets (paper trading dashboard).
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# LIVE TRADING SAFETY LOCK. Leave this line commented out unless you have read the
# "Going live" section of README.md and truly accept that real money can be lost:
# KWANT_ALLOW_LIVE=YES_I_ACCEPT_THE_RISK

# Optional: password for the dashboard's REMOTE mode (python -m kwanttrades web --remote, e.g. to open it from your
# phone on your home Wi-Fi). At least 12 characters. Without this line remote mode refuses to start. Pick a
# password you use nowhere else; it is never shown, logged or sent anywhere by Kwant Trades.
KWANT_WEB_PASSWORD=
